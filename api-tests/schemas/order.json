{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "status",
    "totalAmount",
    "currency",
    "deliveryZone",
    "address",
    "items",
    "cancellationReason"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "CREATED",
        "PAID",
        "COOKING",
        "OUT_FOR_DELIVERY",
        "DELIVERED",
        "CANCELLED"
      ]
    },
    "totalAmount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "const": "EUR"
    },
    "deliveryZone": {
      "enum": [
        "CENTER",
        "OUTSKIRTS"
      ]
    },
    "address": {
      "type": "object",
      "required": [
        "city",
        "street",
        "house",
        "apartment",
        "postcode"
      ],
      "properties": {
        "city": {
          "type": "string",
          "minLength": 1
        },
        "street": {
          "type": "string",
          "minLength": 1
        },
        "house": {
          "type": "string",
          "minLength": 1
        },
        "apartment": {
          "type": [
            "string",
            "null"
          ]
        },
        "postcode": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "size",
          "qty"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "enum": [
              "SMALL",
              "MEDIUM",
              "LARGE"
            ]
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "cancellationReason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
